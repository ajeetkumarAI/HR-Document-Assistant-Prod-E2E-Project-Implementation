# ---------------------------------------------------------------------------
# Secrets & per-environment overrides. Copy to .env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

# OpenAI (LLM + embeddings)
OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=            # e.g. Azure OpenAI / gateway URL

# LangSmith tracing + evaluation (https://smith.langchain.com)
LANGSMITH_API_KEY=lsv2_your-key
LANGSMITH_PROJECT=hr-document-assistant
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region

# API keys -> roles  (employee | manager | hr_admin)
API_KEYS={"dev-employee-key":"employee","dev-manager-key":"manager","dev-admin-key":"hr_admin"}

# Optional providers
# COHERE_API_KEY=
# QDRANT_API_KEY=             # Qdrant Cloud

# Any config.yaml value can be overridden with "__" nesting, e.g.
# LLM__MODEL=gpt-6.1-sol
# VECTORDB__MODE=server
# VECTORDB__URL=http://localhost:6333
# CACHE__BACKEND=redis
# RERANKER__PROVIDER=llm
